<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

    <Package
    Name="duplicata"
    Manufacturer="duplicata"
    Version="$(var.ProductVersion)"
    UpgradeCode="8A8BC285-7C38-48C3-915B-5666902B88C3"
    Scope="perUser"
    InstallerVersion="500">

        <Media Id="1" Cabinet="duplicata.cab" EmbedCab="yes" />

        <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    
        <MajorUpgrade
      AllowDowngrades="no"
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="Uma versão mais nova do duplicata já está instalada. Instalar uma versão mais antiga por cima poderia deixar o histórico protegido pela sua conta do Windows ilegível. Se você precisa mesmo voltar a uma versão anterior: desinstale esta primeiro, escolhendo o que fazer com os dados guardados, e então instale a versão desejada." />

        <Property Id="STARTUPRUNPRESENT">
      <RegistrySearch Id="StartupRunPresentSearch"
                      Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="duplicata"
                      Type="raw" />
    </Property>

        <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="duplicata">
          <Component Id="MainExecutable" Guid="*">
                        <File Id="duplicata.exe"
                  Source="$(var.DuplicataExePath)"
                  KeyPath="yes" />
          </Component>

                    <Component Id="StartupRegistryEntry" Guid="*">
            <RegistryValue Root="HKCU"
                           Key="Software\Microsoft\Windows\CurrentVersion\Run"
                           Name="duplicata"
                           Type="string"
                           Value="[#duplicata.exe]"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="duplicata" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartupRegistryEntry" />
    </Feature>

        <SetProperty Id="WixShellExecTarget"
                 Value="[#duplicata.exe]"
                 Before="LaunchApplication"
                 Sequence="execute" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Impersonate="yes"
                  Execute="immediate"
                  Return="ignore" />

        <SetProperty Id="RequestShutdownOnUninstall"
                 Value="&quot;[#duplicata.exe]&quot; --request-shutdown"
                 Before="RequestShutdownOnUninstall"
                 Sequence="execute" />
    <CustomAction Id="RequestShutdownOnUninstall"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Impersonate="yes"
                  Execute="deferred"
                  Return="ignore" />

    <SetProperty Id="UninstallDataOnUninstall"
                 Value="&quot;[#duplicata.exe]&quot; --uninstall-data"
                 Before="UninstallDataOnUninstall"
                 Sequence="execute" />
    <CustomAction Id="UninstallDataOnUninstall"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Impersonate="yes"
                  Execute="deferred"
                  Return="ignore" />

        <SetProperty Id="PreserveStartupChoiceOnUpgrade"
                 Value="&quot;[#duplicata.exe]&quot; --clear-run-entry"
                 Before="PreserveStartupChoiceOnUpgrade"
                 Sequence="execute" />
    <CustomAction Id="PreserveStartupChoiceOnUpgrade"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Impersonate="yes"
                  Execute="deferred"
                  Return="ignore" />

    <InstallExecuteSequence>
            <Custom Action="LaunchApplication" After="InstallFinalize"
              Condition="NOT Installed AND NOT REMOVE" />
            <Custom Action="RequestShutdownOnUninstall" After="InstallInitialize"
              Condition="REMOVE=&quot;ALL&quot;" />
            <Custom Action="UninstallDataOnUninstall" After="RequestShutdownOnUninstall"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
            <Custom Action="PreserveStartupChoiceOnUpgrade" After="WriteRegistryValues"
              Condition="WIX_UPGRADE_DETECTED AND NOT STARTUPRUNPRESENT" />
    </InstallExecuteSequence>

    
  </Package>
</Wix>
